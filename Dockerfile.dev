# The default is the Python of current Home Assistant; CI and the pre-push hook
# also build 3.13, which gets the last core that ran on it.
ARG PYTHON_VERSION=3.14
FROM python:${PYTHON_VERSION}-slim

RUN apt-get update -qq && \
    apt-get install -qq -y --no-install-recommends gcc libc-dev > /dev/null 2>&1 && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    ruff mypy vulture \
    pytest pytest-asyncio pytest-cov \
    httpx firebase-messaging homeassistant \
    "python-socketio[asyncio_client]>=5.12.0" \
    av "pymediasoup==1.5.0" "aiortc==1.16.0" Pillow numpy PyTurboJPEG \
    && pip install --no-cache-dir aiodns pycares

WORKDIR /app
